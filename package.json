{
  "name": "tarbiyah-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/server.js",
    "dev:all": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "test": "node -e \"import('node:fs').then(async fs=>{const {spawnSync}=await import('node:child_process');const r=spawnSync(process.execPath,['node_modules/vitest/vitest.mjs','run'],{cwd:fs.realpathSync.native('.'),stdio:'inherit',env:{...process.env,NODE_ENV:'test',ALLOW_PUBLIC_REGISTER:'true',ALLOW_SANDBOX_RESET:'true'}});process.exit(r.status??1)})\"",
    "test:e2e": "playwright test",
    "check:server": "node -e \"import('node:fs').then(async fs=>{const {execSync}=await import('node:child_process');const walk=(d)=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?[...walk(d+'/'+e.name)]:e.name.endsWith('.js')?[d+'/'+e.name]:[]);for(const f of [...walk('server'),...walk('src')]){execSync('node --check \"'+f+'\"',{stdio:'inherit'})}console.log('All JS syntax OK')})\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-vue-next": "^1.0.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
